<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kanata must run as root on macOS, so this is a system LaunchDaemon.
     Install (see macos/README.md):
       sudo cp kanata.plist /Library/LaunchDaemons/dev.kanata.kanata.plist
     Reference file only — never stowed (see --ignore in dot-stowrc). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kanata.kanata</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/kanata</string>
        <string>--cfg</string>
        <string>/Users/toby/.config/kanata/mac.kbd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/kanata.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/kanata.log</string>
</dict>
</plist>
